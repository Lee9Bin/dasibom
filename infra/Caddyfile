{$SITE_HOST} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    -Server
  }
  @private path /api/v1/admin/* /actuator/*
  respond @private 404
  reverse_proxy frontend:3000
}
:80 {
  redir https://{$SITE_HOST}{uri} permanent
}
